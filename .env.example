# Copy file này thành .env rồi đổi các giá trị "change-me". KHÔNG commit file .env.
# Mật khẩu Postgres nên chỉ gồm chữ và số (ký tự đặc biệt làm hỏng DATABASE_URL).
POSTGRES_USER=ibanking
POSTGRES_PASSWORD=change_me_123

# JWT dùng chung giữa User, Tuition, Payment (HS256)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=60

# Khóa gọi nội bộ giữa các service (header X-Internal-Key)
INTERNAL_API_KEY=change-me-internal-key

# Khóa ký CSRF token của Web/BFF
WEB_SECRET_KEY=change-me-web-secret
COOKIE_SECURE=false

# OTP và email
OTP_HMAC_SECRET=change-me-otp-hmac-secret
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=60
MAIL_FROM=no-reply@ibanking.local

# Job đối soát của Payment (giá trị mặc định dùng cho demo; chỉ đổi khi chạy tests/smoke_reconcile.py)
RECONCILE_INTERVAL_SECONDS=30
TRANSACTION_EXPIRE_GRACE_SECONDS=600
RECONCILE_STUCK_SECONDS=60
RECONCILE_RELEASE_WINDOW_SECONDS=600
# OTP_TTL_SECONDS=300     # bỏ comment để thay OTP_TTL_MINUTES (chỉ để kiểm thử)
